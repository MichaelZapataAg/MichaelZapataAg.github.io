---

---

<div
    class="relative w-full h-full flex items-center justify-center group"
    id="three-scene-wrapper"
>
    <button
        id="prev-model"
        aria-label="Modelo anterior"
        class="absolute left-0 md:left-2 z-20 w-10 h-10 md:w-12 md:h-12 bg-black text-white border-4 border-black font-display font-black flex items-center justify-center brutal-shadow hover:bg-neo-green hover:text-black transition-colors sound-hover opacity-100 md:opacity-0 md:group-hover:opacity-100 md:focus-visible:opacity-100 transition-opacity cursor-pointer"
    >
        &lt;
    </button>

    <div
        id="canvas-container"
        class="w-full h-full cursor-crosshair flex justify-center items-center"
    >
        <canvas id="webgl" class="w-full h-full outline-none block"></canvas>
    </div>

    <button
        id="next-model"
        aria-label="Modelo siguiente"
        class="absolute right-0 md:right-2 z-20 w-10 h-10 md:w-12 md:h-12 bg-black text-white border-4 border-black font-display font-black flex items-center justify-center brutal-shadow hover:bg-neo-green hover:text-black transition-colors sound-hover opacity-100 md:opacity-0 md:group-hover:opacity-100 md:focus-visible:opacity-100 transition-opacity cursor-pointer"
    >
        &gt;
    </button>
</div>

<script>
    import * as THREE from "three";
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const canvasContainer = document.querySelector("#canvas-container");
    const canvas = document.querySelector("canvas#webgl") as HTMLCanvasElement;
    const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    // Simplex noise 3D (Ashima Arts / Stefan Gustavson, MIT)
    const NOISE_GLSL = /* glsl */ `
        vec3 mod289(vec3 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
        vec4 mod289(vec4 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
        vec4 permute(vec4 x) { return mod289(((x * 34.0) + 1.0) * x); }
        vec4 taylorInvSqrt(vec4 r) { return 1.79284291400159 - 0.85373472095314 * r; }

        float snoise(vec3 v) {
            const vec2 C = vec2(1.0 / 6.0, 1.0 / 3.0);
            const vec4 D = vec4(0.0, 0.5, 1.0, 2.0);

            vec3 i = floor(v + dot(v, C.yyy));
            vec3 x0 = v - i + dot(i, C.xxx);

            vec3 g = step(x0.yzx, x0.xyz);
            vec3 l = 1.0 - g;
            vec3 i1 = min(g.xyz, l.zxy);
            vec3 i2 = max(g.xyz, l.zxy);

            vec3 x1 = x0 - i1 + C.xxx;
            vec3 x2 = x0 - i2 + C.yyy;
            vec3 x3 = x0 - D.yyy;

            i = mod289(i);
            vec4 p = permute(permute(permute(
                i.z + vec4(0.0, i1.z, i2.z, 1.0))
                + i.y + vec4(0.0, i1.y, i2.y, 1.0))
                + i.x + vec4(0.0, i1.x, i2.x, 1.0));

            float n_ = 0.142857142857;
            vec3 ns = n_ * D.wyz - D.xzx;

            vec4 j = p - 49.0 * floor(p * ns.z * ns.z);

            vec4 x_ = floor(j * ns.z);
            vec4 y_ = floor(j - 7.0 * x_);

            vec4 x = x_ * ns.x + ns.yyyy;
            vec4 y = y_ * ns.x + ns.yyyy;
            vec4 h = 1.0 - abs(x) - abs(y);

            vec4 b0 = vec4(x.xy, y.xy);
            vec4 b1 = vec4(x.zw, y.zw);

            vec4 s0 = floor(b0) * 2.0 + 1.0;
            vec4 s1 = floor(b1) * 2.0 + 1.0;
            vec4 sh = -step(h, vec4(0.0));

            vec4 a0 = b0.xzyw + s0.xzyw * sh.xxyy;
            vec4 a1 = b1.xzyw + s1.xzyw * sh.zzww;

            vec3 p0 = vec3(a0.xy, h.x);
            vec3 p1 = vec3(a0.zw, h.y);
            vec3 p2 = vec3(a1.xy, h.z);
            vec3 p3 = vec3(a1.zw, h.w);

            vec4 norm = taylorInvSqrt(vec4(dot(p0, p0), dot(p1, p1), dot(p2, p2), dot(p3, p3)));
            p0 *= norm.x;
            p1 *= norm.y;
            p2 *= norm.z;
            p3 *= norm.w;

            vec4 m = max(0.6 - vec4(dot(x0, x0), dot(x1, x1), dot(x2, x2), dot(x3, x3)), 0.0);
            m = m * m;
            return 42.0 * dot(m * m, vec4(dot(p0, x0), dot(p1, x1), dot(p2, x2), dot(p3, x3)));
        }
    `;

    const VERTEX_SHADER = /* glsl */ `
        uniform float uTime;
        uniform float uAmp;
        varying float vNoise;
        varying vec3 vNormalV;
        varying vec3 vViewDir;

        ${NOISE_GLSL}

        void main() {
            float n = snoise(position * 0.45 + vec3(0.0, 0.0, uTime * 0.25));
            // Desplazamiento en bandas: mitad orgánico, mitad glitch escalonado
            float banded = floor(n * 5.0) / 5.0;
            float disp = mix(n, banded, 0.55) * uAmp;

            vec3 newPosition = position + normal * disp;
            vec4 mvPosition = modelViewMatrix * vec4(newPosition, 1.0);

            vNoise = n;
            vNormalV = normalize(normalMatrix * normal);
            vViewDir = normalize(-mvPosition.xyz);
            gl_Position = projectionMatrix * mvPosition;
        }
    `;

    const FRAGMENT_SHADER = /* glsl */ `
        uniform float uTime;
        uniform vec3 uColorA;
        uniform vec3 uColorB;
        uniform vec3 uColorC;
        varying float vNoise;
        varying vec3 vNormalV;
        varying vec3 vViewDir;

        void main() {
            float t = vNoise * 0.5 + 0.5;
            vec3 color = mix(uColorB, uColorA, smoothstep(0.15, 0.85, t));

            // Borde fresnel en verde neón
            float fresnel = pow(1.0 - max(dot(normalize(vNormalV), normalize(vViewDir)), 0.0), 2.5);
            color = mix(color, uColorC, fresnel);

            // Scanlines CRT sutiles
            float scan = step(0.5, fract(gl_FragCoord.y * 0.12 + uTime * 1.5)) * 0.07;
            color -= scan;

            gl_FragColor = vec4(color, 1.0);
        }
    `;

    if (canvasContainer && canvas) {
        const scene = new THREE.Scene();

        const camera = new THREE.PerspectiveCamera(
            35,
            canvasContainer.clientWidth / canvasContainer.clientHeight,
            0.1,
            100,
        );
        camera.position.z = 15;
        scene.add(camera);

        const uniforms = {
            uTime: { value: 0 },
            uAmp: { value: 0.85 },
            uColorA: { value: new THREE.Color("#FF0055") },
            uColorB: { value: new THREE.Color("#0033FF") },
            uColorC: { value: new THREE.Color("#CCFF00") },
        };

        const shaderMaterial = new THREE.ShaderMaterial({
            uniforms,
            vertexShader: VERTEX_SHADER,
            fragmentShader: FRAGMENT_SHADER,
        });

        // Luces: el shader las ignora, pero el modelo GLB sí las necesita
        scene.add(new THREE.AmbientLight(0xffffff, 1.4));
        const keyLight = new THREE.DirectionalLight(0xffffff, 2.2);
        keyLight.position.set(5, 8, 6);
        scene.add(keyLight);
        const fillLight = new THREE.DirectionalLight(0xffccdd, 0.9);
        fillLight.position.set(-6, 2, -4);
        scene.add(fillLight);

        const group = new THREE.Group();
        scene.add(group);

        // El "escenario" es lo que escala al cambiar de forma
        // (mesh procedural o modelo GLB)
        const stage = new THREE.Group();
        stage.position.y -= 0.5;
        group.add(stage);

        // Formas de alta densidad para que el shader tenga vértices que retorcer.
        // Cada una con su propia amplitud: el blob aguanta más distorsión que el nudo.
        const shapes: any[] = [
            { geo: new THREE.IcosahedronGeometry(3.2, 48), amp: 0.85 },
            { geo: new THREE.TorusKnotGeometry(2, 0.62, 300, 48), amp: 0.3 },
            { geo: new THREE.OctahedronGeometry(3.5, 24), amp: 0.55 },
            { geo: new THREE.TorusGeometry(2.4, 1, 96, 200), amp: 0.4 },
        ];
        let currentIndex = 0;

        const model = new THREE.Mesh(shapes[currentIndex].geo, shaderMaterial);
        stage.add(model);

        /**============================================
         * PARTÍCULAS — cuadros crudos en la paleta neo
         *=============================================**/
        const PARTICLE_COUNT = 1300;
        const palette = [
            new THREE.Color("#FF0055"),
            new THREE.Color("#0033FF"),
            new THREE.Color("#CCFF00"),
            new THREE.Color("#FF5500"),
            new THREE.Color("#000000"),
        ];
        const positions = new Float32Array(PARTICLE_COUNT * 3);
        const colors = new Float32Array(PARTICLE_COUNT * 3);
        for (let i = 0; i < PARTICLE_COUNT; i++) {
            // Cascarón esférico alrededor del modelo (radio 4.5–10)
            const r = 4.5 + Math.random() * 5.5;
            const theta = Math.random() * Math.PI * 2;
            const phi = Math.acos(2 * Math.random() - 1);
            positions[i * 3] = r * Math.sin(phi) * Math.cos(theta);
            positions[i * 3 + 1] = r * Math.sin(phi) * Math.sin(theta) - 0.5;
            positions[i * 3 + 2] = r * Math.cos(phi);

            const c = palette[Math.floor(Math.random() * palette.length)];
            colors[i * 3] = c.r;
            colors[i * 3 + 1] = c.g;
            colors[i * 3 + 2] = c.b;
        }
        const particleGeometry = new THREE.BufferGeometry();
        particleGeometry.setAttribute(
            "position",
            new THREE.BufferAttribute(positions, 3),
        );
        particleGeometry.setAttribute(
            "color",
            new THREE.BufferAttribute(colors, 3),
        );
        // Sin textura los puntos se dibujan como cuadrados: brutalismo gratis
        const particleMaterial = new THREE.PointsMaterial({
            size: 0.09,
            vertexColors: true,
            sizeAttenuation: true,
            transparent: true,
            opacity: 0.85,
            depthWrite: false,
        });
        const particles = new THREE.Points(particleGeometry, particleMaterial);
        scene.add(particles);

        // Initial scale animation
        if (!reduceMotion) {
            gsap.from(group.scale, {
                x: 0,
                y: 0,
                z: 0,
                duration: 1.5,
                ease: "elastic.out(1, 0.75)",
                delay: 0.5,
            });
            gsap.from(uniforms.uAmp, {
                value: 0,
                duration: 2,
                ease: "power2.out",
                delay: 0.5,
            });
        }

        // Arrow Nav Logic
        const applyShape = () => {
            const shape = shapes[currentIndex];
            shapes.forEach((s) => {
                if (s.object) s.object.visible = false;
            });
            if (shape.object) {
                model.visible = false;
                shape.object.visible = true;
            } else {
                model.visible = true;
                model.geometry = shape.geo;
                if (reduceMotion) uniforms.uAmp.value = shape.amp;
                else gsap.to(uniforms.uAmp, { value: shape.amp, duration: 0.8 });
            }
        };

        const updateGeometry = () => {
            if (reduceMotion) {
                applyShape();
                renderer.render(scene, camera);
                return;
            }
            gsap.to(stage.scale, {
                x: 0,
                y: 0,
                z: 0,
                duration: 0.3,
                ease: "back.in(1.5)",
                onComplete: () => {
                    applyShape();
                    gsap.to(stage.scale, {
                        x: 1,
                        y: 1,
                        z: 1,
                        duration: 0.8,
                        ease: "elastic.out(1, 0.75)",
                    });
                },
            });
        };

        document.getElementById("next-model")?.addEventListener("click", () => {
            currentIndex = (currentIndex + 1) % shapes.length;
            updateGeometry();
        });

        document.getElementById("prev-model")?.addEventListener("click", () => {
            currentIndex =
                (currentIndex - 1 + shapes.length) % shapes.length;
            updateGeometry();
        });

        /**============================================
         * MODELO GLB — bodegón de cerezas (carga diferida
         * para no competir con el primer render)
         *=============================================**/
        setTimeout(() => {
            import("three/addons/loaders/GLTFLoader.js")
                .then(({ GLTFLoader }) =>
                    new GLTFLoader().loadAsync("/models/cerezas.glb"),
                )
                .then((gltf) => {
                    const obj = gltf.scene;
                    // Fuera el plano de fondo pintado: taza y cerezas flotando
                    const drop: any[] = [];
                    obj.traverse((n) => {
                        if (n.name === "Plane_Fondo_0") drop.push(n);
                    });
                    drop.forEach((n) => n.removeFromParent());

                    const box = new THREE.Box3().setFromObject(obj);
                    obj.position.sub(box.getCenter(new THREE.Vector3()));
                    const size = box.getSize(new THREE.Vector3());
                    const wrap = new THREE.Group();
                    wrap.add(obj);
                    wrap.scale.setScalar(7 / Math.max(size.x, size.y, size.z));
                    wrap.visible = false;
                    stage.add(wrap);
                    shapes.push({ object: wrap });
                })
                .catch(() => {}); // sin el modelo, la escena sigue igual
        }, 2500);

        const renderer = new THREE.WebGLRenderer({
            canvas: canvas,
            alpha: true,
            antialias: true,
        });

        const updateSize = () => {
            if (!canvasContainer) return;
            const width = canvasContainer.clientWidth;
            const height = canvasContainer.clientHeight;
            renderer.setSize(width, height);
            camera.aspect = width / height;
            camera.updateProjectionMatrix();
            if (reduceMotion) renderer.render(scene, camera);
        };

        updateSize();
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

        window.addEventListener("resize", updateSize);

        if (reduceMotion) {
            // Pose estática legible; sin loop de animación
            group.rotation.set(0.35, 0.6, 0);
            uniforms.uTime.value = 1.5;
            renderer.render(scene, camera);
        } else {
            const timer = new THREE.Clock();
            let animTime = 0;

            let mouseX = 0;
            let mouseY = 0;
            let targetRotationX = 0;
            let targetRotationY = 0;

            window.addEventListener("mousemove", (event) => {
                if (!canvasContainer) return;
                mouseX = event.clientX / window.innerWidth - 0.5;
                mouseY = event.clientY / window.innerHeight - 0.5;
            });

            let rafId = 0;
            let running = false;

            const tick = () => {
                animTime += timer.getDelta();
                uniforms.uTime.value = animTime;

                targetRotationX += (mouseY * 2.5 - targetRotationX) * 0.05;
                targetRotationY += (mouseX * 2.5 - targetRotationY) * 0.05;

                // El modelo GLB gira solo en Y (tornamesa); los blobs dan tumbos
                const isModel = !!shapes[currentIndex]?.object;
                group.rotation.y = animTime * 0.15 + targetRotationY;
                group.rotation.x = isModel
                    ? targetRotationX * 0.4
                    : animTime * 0.1 + targetRotationX;

                group.position.y += Math.sin(animTime) * 0.002;

                // Las partículas giran lento en sentido contrario
                particles.rotation.y = -animTime * 0.05 + targetRotationY * 0.3;
                particles.rotation.x = targetRotationX * 0.2;

                renderer.render(scene, camera);
                rafId = window.requestAnimationFrame(tick);
            };

            const start = () => {
                if (running) return;
                running = true;
                timer.getDelta(); // descarta el tiempo pausado
                rafId = window.requestAnimationFrame(tick);
            };
            const stop = () => {
                if (!running) return;
                running = false;
                window.cancelAnimationFrame(rafId);
            };

            // Pausa el render cuando la escena sale del viewport
            const wrapper = document.querySelector("#three-scene-wrapper");
            if (wrapper && "IntersectionObserver" in window) {
                new IntersectionObserver(([entry]) =>
                    entry.isIntersecting ? start() : stop(),
                ).observe(wrapper);
            } else {
                start();
            }

            ScrollTrigger.create({
                trigger: "body",
                start: "top top",
                end: "bottom bottom",
                onUpdate: (self) => {
                    targetRotationY += self.getVelocity() / 25000;
                    targetRotationX += self.getVelocity() / 50000;
                },
            });
        }
    }
</script>

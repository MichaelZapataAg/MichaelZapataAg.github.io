    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      /**============================================
       * AUDIO FEEDBACK
       *=============================================**/
      const AudioContext =
        window.AudioContext || (window as any).webkitAudioContext;
      let audioCtx: AudioContext | null = null;
      let soundMuted = localStorage.getItem("soundMuted") === "1";

      const soundToggle = document.getElementById("sound-toggle");
      const updateSoundToggle = () => {
        if (!soundToggle) return;
        soundToggle.textContent = soundMuted ? "×" : "♪";
        soundToggle.setAttribute("aria-pressed", String(!soundMuted));
        soundToggle.classList.toggle("opacity-40", soundMuted);
      };
      updateSoundToggle();
      soundToggle?.addEventListener("click", () => {
        soundMuted = !soundMuted;
        localStorage.setItem("soundMuted", soundMuted ? "1" : "0");
        updateSoundToggle();
      });

      const playBoop = async () => {
        if (soundMuted) return;
        if (!audioCtx) return; // Prevent errors if context wasn't created properly

        if (audioCtx.state === "suspended") await audioCtx.resume();
        // Return early if the interaction wasn't a manual trigger resulting in a running state
        if (audioCtx.state !== "running") return;

        const ctx = audioCtx; // bind for non-null checks logically for typescript
        const osc = ctx.createOscillator();
        const gainNode = ctx.createGain();
        osc.type = "square";
        osc.frequency.setValueAtTime(150, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(40, ctx.currentTime + 0.1);
        gainNode.gain.setValueAtTime(0.015, ctx.currentTime);
        gainNode.gain.exponentialRampToValueAtTime(
          0.0001,
          ctx.currentTime + 0.1,
        );
        osc.connect(gainNode);
        gainNode.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.1);
      };

      document.querySelectorAll("a, .sound-hover").forEach((el) => {
        el.addEventListener("mouseenter", () => {
          // Initialize AudioContext if not already done, usually requires user interaction beforehand
          if (!audioCtx) {
            try {
              audioCtx = new AudioContext();
            } catch (e) {
              return;
            }
          }
          playBoop();
        });
      });

      /**============================================
       * INTERACTIVE MAGNETIC PORTFOLIO TEXT
       *=============================================**/
      const badge = document.querySelector(".portfolio-badge");
      if (badge && !prefersReducedMotion) {
        badge.addEventListener("mousemove", (e: any) => {
          const rect = badge.getBoundingClientRect();
          const x = e.clientX - rect.left - rect.width / 2;
          const y = e.clientY - rect.top - rect.height / 2;
          gsap.to(badge, {
            x: x * 0.4,
            y: y * 0.4,
            duration: 0.3,
            ease: "power2.out",
          });
        });
        badge.addEventListener("mouseleave", () => {
          gsap.to(badge, {
            x: 0,
            y: 0,
            duration: 0.5,
            ease: "elastic.out(1, 0.3)",
          });
        });
      }

      /**============================================
       * INTERACTIVE GLITCH NAME HOVER
       *=============================================**/
      const nameHoverElements = document.querySelectorAll(
        ".interactive-name .hover-glitch",
      );
      nameHoverElements.forEach((el) => {
        el.addEventListener("mouseenter", () => {
          if (prefersReducedMotion) return;
          gsap.to(el, {
            x: () => (Math.random() - 0.5) * 20,
            y: () => (Math.random() - 0.5) * 20,
            skewX: () => (Math.random() - 0.5) * 10,
            duration: 0.1,
            repeat: 3,
            yoyo: true,
            onComplete: () => {
              gsap.to(el, { x: 0, y: 0, skewX: 0, duration: 0.2 });
            },
          });

          if (!soundMuted && audioCtx && audioCtx.state === "running") {
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = "sawtooth";
            osc.frequency.setValueAtTime(50, audioCtx.currentTime);
            osc.frequency.exponentialRampToValueAtTime(
              800,
              audioCtx.currentTime + 0.1,
            );
            gain.gain.setValueAtTime(0.005, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(
              0.0001,
              audioCtx.currentTime + 0.1,
            );
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start();
            osc.stop(audioCtx.currentTime + 0.1);
          }
        });
      });

      /**============================================
       * GSAP UI ANIMATIONS
       *=============================================**/
      // Initial Load Animation
      if (prefersReducedMotion) {
        // Sin animación de entrada: solo asegura visibilidad
        gsap.set([".title-animate", ".init-animate"], { opacity: 1 });
      } else {
        const tl = gsap.timeline();

        tl.from(".title-animate", {
          y: 50,
          opacity: 0,
          duration: 1,
          ease: "power4.out",
          delay: 0.2,
        }).fromTo(
          ".init-animate",
          {
            scale: 0.8,
            rotation: -10,
            opacity: 0,
          },
          {
            scale: 1,
            rotation: 0, // Reset to inline block natural rotation or keep existing base. For the rotated box we might need from() without rotation if it breaks it, let's use a clear fromTo to keep opacity stable.
            opacity: 1,
            clearProps: "scale,rotation",
            duration: 0.8,
            stagger: 0.2,
            ease: "back.out(1.5)",
          },
          "-=0.5",
        );
      }
    </script>

---
import { Image } from "astro:assets";
import "../styles/global.css";
import ThreeScene from "./ThreeScene.astro";

import maikImg from "../assets/images/Maik.jpeg";
import dimensioImg from "../assets/images/MockupDimensio.png";
import smogImg from "../assets/images/PosterSmog.png";
import aMediasImg from "../assets/images/AMediasPoster.jpeg";
import demoReel from "../assets/videos/DemoReelSimple.mp4";

export interface Props {
  lang: "es" | "en";
}
const { lang = "es" } = Astro.props;

const SITE = "https://michaelzapataag.github.io";
const pageUrl = lang === "es" ? `${SITE}/` : `${SITE}/en/`;
const ogImage = `${SITE}/og-image.jpg`;
const seoTitle = "Michael Zapata | Creative Frontend Developer & 3D";
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Michael Zapata",
  url: SITE,
  image: ogImage,
  jobTitle: "Creative Frontend Developer",
  email: "michael.zapata.ag@gmail.com",
  sameAs: [
    "https://www.linkedin.com/in/michaelzapataag/",
    "https://github.com/MichaelZapataAg",
    "https://sketchfab.com/MichaelZapataAg",
  ],
};

const t = {
  seo_desc: {
    es: "Portafolio de Michael Zapata, creative frontend developer. Experiencias web interactivas y 3D en el navegador con React, Three.js y GSAP.",
    en: "Portfolio of Michael Zapata, creative frontend developer. Interactive web and 3D browser experiences built with React, Three.js and GSAP.",
  },
  og_alt: {
    es: "Michael Zapata, Creative Frontend Developer y artista 3D",
    en: "Michael Zapata, Creative Frontend Developer and 3D artist",
  },
  hi: { es: "HOLA, SOY", en: "HELLO, I'M" },
  portfolio: { es: "[ PORTAFOLIO ]", en: "[ PORTFOLIO ]" },
  job: {
    es: "Creative Frontend Developer",
    en: "Creative Frontend Developer",
  },
  desc: {
    es: "No te aburro con líneas genéricas, dejo que mis visuales hablen por mí. Código crudo, experiencias memorables y píxeles en tres dimensiones disparados al navegador.",
    en: "I won't bore you with generic lines, I let my visuals speak for me. Raw code, memorable experiences, and 3D pixels fired into the browser.",
  },
  contact_btn: { es: "CONTÁCTAME →", en: "CONTACT ME →" },
  marquee1: {
    es: "DESARROLLO CREATIVO &nbsp; • &nbsp; ANIMACIÓN 3D &nbsp; • &nbsp; INTERFACES BRUTALISTAS",
    en: "CREATIVE DEVELOPMENT &nbsp; • &nbsp; 3D ANIMATION &nbsp; • &nbsp; BRUTALIST INTERFACES",
  },
  arsenal: { es: "MI <br /> ARSENAL", en: "MY <br /> ARSENAL" },
  soft_skills_title: { es: "Habilidades Blandas", en: "Soft Skills" },
  skills: {
    "Resolución de problemas": "Problem Solving",
    Creatividad: "Creativity",
    "Trabajo en equipo": "Teamwork",
    Adaptabilidad: "Adaptability",
    "Comunicación asertiva": "Assertive Communication",
    "Pensamiento lateral": "Lateral Thinking",
    "IAs generativas": "Generative AIs",
  },
  why_me_title: { es: "¿POR QUÉ YO?", en: "WHY ME?" },
  why_me_desc: {
    es: "Me especializo en crear productos visualmente magnéticos y funcionalmente impecables. Mi estilo es versátil: puedo abrazar desde el minimalismo más pulido hasta interfaces brutalistas o inmersivas que desafían las convenciones.",
    en: "I specialize in creating visually magnetic and functionally flawless products. My style is versatile: I can embrace everything from highly polished minimalism to brutalist or immersive interfaces that defy conventions.",
  },
  marquee2: {
    es: "HARD SURFACE &nbsp; • &nbsp; REALIDAD VIRTUAL &nbsp; • &nbsp; DISEÑO DE ENTORNOS",
    en: "HARD SURFACE &nbsp; • &nbsp; VIRTUAL REALITY &nbsp; • &nbsp; ENVIRONMENT DESIGN",
  },
  projects_title: { es: "PROYECTOS", en: "PROJECTS" },
  dimensios_desc: {
    es: "Un portal inmersivo construido con React Three Fiber. Este experimento demuestra el uso de shaders procedimentales y físicas 3D aplicadas directamente al navegador moderno, rompiendo lo estático. Integra además la capacidad técnica de cargar interactivamente y probar tus propios modelos 3D.",
    en: "An immersive portal built with React Three Fiber. This experiment demonstrates the use of procedural shaders and 3D physics applied directly to the modern browser, breaking away from static pages. It also integrates the technical capability to interactively load and test your own 3D models.",
  },
  interactive_experience: {
    es: "Experiencia 3D Interactiva",
    en: "Interactive 3D Experience",
  },
  smog_title: {
    es: "LA VENGANZA <br />DEL SMOG",
    en: "LA VENGANZA <br />DEL SMOG",
  },
  smog_desc: {
    es: "Un atrapante plataformero de acción 2D inspirado en los clásicos arcade y bañado en una rica estética Pixel Art. Toda la atmósfera y temática del proyecto está directamente basada en Medellín y la intensa problemática real de su contaminación.",
    en: "A captivating 2D action platformer inspired by arcade classics and bathed in a rich Pixel Art aesthetic. The entire atmosphere and theme of the project is directly based on Medellín and its intense real-world pollution problem.",
  },
  platformer: {
    es: "Plataformero 2D / Pixel Art",
    en: "2D Platformer / Pixel Art",
  },
  watch_gameplay: {
    es: "Ver Gameplay en YouTube",
    en: "Watch Gameplay on YouTube",
  },
  amedias_desc: {
    es: "Animación 3D interactiva, donde puedes vivir en carne propia el sorprendente mundo bajo la cama en Realidad Virtual. Acompaña a nuestra protagonista Nona en la férrea búsqueda de su pareja, mientras afronta complejas situaciones sobre el apego emocional y la superación de sus problemas.",
    en: "Interactive 3D animation, where you can experience firsthand the surprising world under the bed in Virtual Reality. Join our protagonist Nona in the fierce search for her partner, while confronting complex situations involving emotional attachment and overcoming her problems.",
  },
  vr_interactive: { es: "VR / Interactivo", en: "VR / Interactive" },
  vr_animation: {
    es: "Animación interactiva en Realidad Virtual",
    en: "Interactive Animation in Virtual Reality",
  },
  animation_title: { es: "ANIMACIÓN GENERAL", en: "GENERAL ANIMATION" },
  animation_tags: {
    es: "Animación 3D, 2D y VFX",
    en: "3D Animation, 2D and VFX",
  },
  animation_desc: {
    es: "Una colección con algunas de mis piezas animadas. El carrete abarca un rango técnico diverso que va desde lip syncs y walk cycles estructurados, hasta simulaciones tridimensionales fluidas.",
    en: "A collection featuring some of my animated pieces. The reel spans a diverse technical range, from structured lip syncs and walk cycles, to fluid three-dimensional simulations.",
  },
  lets_talk: { es: "HABLEMOS", en: "LET'S TALK" },
  made_with: { es: "HECHO CON", en: "MADE WITH" },
  attitude: { es: "ACTITUD", en: "ATTITUDE" },
  cv_btn: { es: "DESCARGAR CV", en: "DOWNLOAD CV (ES)" },
  sound_toggle_label: {
    es: "Activar o silenciar los efectos de sonido",
    en: "Toggle sound effects on or off",
  },
  alt_maik: {
    es: "Retrato de Michael Zapata",
    en: "Portrait of Michael Zapata",
  },
  alt_dimensios: {
    es: "Mockup del proyecto Dimensios, experiencia web 3D interactiva",
    en: "Mockup of Dimensios, an interactive 3D web experience",
  },
  alt_smog: {
    es: "Póster pixel art del videojuego La Venganza del Smog",
    en: "Pixel art poster of the video game La Venganza del Smog",
  },
  alt_amedias: {
    es: "Póster de A Medias, animación interactiva en realidad virtual",
    en: "Poster of A Medias, an interactive virtual reality animation",
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <title>{seoTitle}</title>
    <meta name="description" content={t.seo_desc[lang]} />
    <meta name="author" content="Michael Zapata" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#EAE6DB" />
    <link rel="canonical" href={pageUrl} />

    <link rel="alternate" hreflang="es" href={`${SITE}/`} />
    <link rel="alternate" hreflang="en" href={`${SITE}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${SITE}/`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Michael Zapata" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={t.seo_desc[lang]} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1080" />
    <meta property="og:image:alt" content={t.og_alt[lang]} />
    <meta property="og:locale" content={lang === "es" ? "es_CO" : "en_US"} />
    <meta
      property="og:locale:alternate"
      content={lang === "es" ? "en_US" : "es_CO"}
    />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={t.seo_desc[lang]} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.og_alt[lang]} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
  </head>
  <body class="bg-paper text-black">
    <!-- Language Switch -->
    <div
      class="fixed top-6 right-6 lg:top-10 lg:right-10 z-[100] brutal-shadow border-4 border-black bg-white flex items-center"
    >
      <a
        href="/"
        class={`px-3 py-1 font-display font-black text-sm uppercase ${lang === "es" ? "bg-black text-white" : "hover:bg-neo-blue transition-colors text-black"}`}
        >ES</a
      >
      <a
        href="/en/"
        class={`px-3 py-1 font-display font-black text-sm uppercase ${lang === "en" ? "bg-black text-white" : "hover:bg-neo-pink transition-colors text-black"}`}
        >EN</a
      >
      <button
        id="sound-toggle"
        aria-label={t.sound_toggle_label[lang]}
        aria-pressed="true"
        class="px-3 py-1 font-display font-black text-sm uppercase border-l-4 border-black hover:bg-neo-green transition-colors text-black cursor-pointer"
        >♪</button
      >
    </div>

    <!-- 3D Canvas Background Removed, see Hero -->

    <div class="noise-overlay"></div>

    <div
      class="relative z-10 wrapper w-full min-h-screen overflow-hidden flex flex-col gap-32"
    >
      <!-- Hero Header -->
      <header
        class="min-h-screen w-full flex flex-col justify-center items-start px-6 sm:px-12 md:px-20 lg:px-32 pt-24"
      >
        <div
          class="brutal-box bg-neo-green px-4 py-2 mt-0 mb-1 sm:mb-2 inline-block transform -rotate-2 brutal-shadow init-animate"
        >
          <span
            class="font-display font-black text-xl md:text-2xl uppercase tracking-tighter"
            >{t.hi[lang]}</span
          >
        </div>

        <div class="flex flex-col items-start gap-0 relative">
          <h1
            class="text-[14vw] sm:text-[16vw] leading-[0.85] font-black text-outline uppercase relative title-animate inline-block group cursor-crosshair interactive-name m-0 p-0"
          >
            <span class="block hover-glitch" data-text="Michael">Michael</span>
            <span
              class="text-black -webkit-text-stroke-0 block hover-glitch"
              data-text="Zapata">Zapata</span
            >
          </h1>

          <div
            class="relative z-10 group cursor-crosshair portfolio-badge init-animate inline-block self-end -mt-2 sm:-mt-4 md:-mt-6 mr-2 sm:mr-8 md:mr-12 opacity-0"
          >
            <a
              href="#proyectos"
              class="inline-block font-display font-black text-[10px] sm:text-xs md:text-sm tracking-[0.2em] md:tracking-[0.3em] uppercase border-4 border-black px-3 py-1 md:px-4 md:py-2 bg-paper hover:bg-black hover:text-white transition-colors duration-300 sound-hover"
            >
              {t.portfolio[lang]}
            </a>
          </div>
        </div>

        <div class="mt-6 md:mt-8 relative w-full desc-box">
          <div
            class="brutal-box bg-black text-white px-4 py-2 md:px-6 md:py-3 inline-block rotate-1 brutal-shadow init-animate"
          >
            <span
              class="font-display font-black text-base sm:text-xl md:text-2xl uppercase tracking-tight"
              >{t.job[lang]}</span
            >
          </div>
          <!-- 3D Canvas Box: vitrina a todo el ancho -->
          <div
            class="relative w-full h-[500px] sm:h-[650px] lg:h-[750px] init-animate flex justify-center items-center"
          >
            <ThreeScene />
          </div>
        </div>
      </header>

      <!-- Marquee divider -->
      <div
        class="marquee-container -rotate-2 z-20 brutal-shadow relative w-full overflow-hidden"
      >
        <div class="marquee-content text-black flex items-center">
          <span
            set:html={`${t.marquee1[lang]} &nbsp; • &nbsp; ${t.marquee1[lang]} &nbsp; • &nbsp; `}
          />
          <span
            set:html={`${t.marquee1[lang]} &nbsp; • &nbsp; ${t.marquee1[lang]} &nbsp; • &nbsp; `}
          />
        </div>
      </div>

      <!-- Playground Section -->
      <section
        id="proyectos"
        class="py-20 md:py-32 px-6 sm:px-12 md:px-20 lg:px-32 border-t-8 border-black"
      >
        <h2
          class="text-[12vw] sm:text-[10vw] md:text-8xl font-black mb-20 text-center text-outline leading-tight"
        >
          {t.projects_title[lang]}
        </h2>
        <div
          class="grid grid-cols-1 lg:grid-cols-2 gap-16 md:gap-12 w-full mx-auto"
        >
          <!-- Card 1 (Dimensios) -->
          <a
            href="https://michaelzapataag-dimensios.vercel.app/"
            target="_blank"
            rel="noopener noreferrer"
            class="block group relative cursor-crosshair lg:col-span-2"
          >
            <div
              class="absolute inset-0 bg-neo-blue border-4 border-black translate-x-4 translate-y-4 transition-transform group-hover:translate-x-8 group-hover:translate-y-8"
            >
            </div>
            <div
              class="relative bg-white border-4 border-black p-6 sm:p-8 flex flex-col md:flex-row lg:flex-row gap-8 transition-transform group-hover:-translate-x-2 group-hover:-translate-y-2 overflow-hidden min-h-[400px]"
            >
              <div
                class="absolute -right-16 -top-16 w-56 h-56 bg-neo-green rounded-full opacity-60 blur-xl group-hover:blur-3xl transition-all duration-500 group-hover:scale-150"
              >
              </div>

              <!-- Mockup Image Slot -->
              <div
                class="w-full md:w-1/2 lg:w-1/2 aspect-video md:aspect-auto min-h-[200px] border-4 border-black bg-white flex items-center justify-center relative z-10 overflow-hidden group"
              >
                <Image
                  src={dimensioImg}
                  alt={t.alt_dimensios[lang]}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </div>

              <div
                class="w-full md:w-1/2 lg:w-1/2 flex flex-col justify-center"
              >
                <div
                  class="flex justify-between items-start z-10 relative mb-4"
                >
                  <h3 class="text-3xl sm:text-4xl lg:text-5xl font-black">
                    DIMENSIOS
                  </h3>
                  <svg
                    viewBox="0 0 16 16"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    class="hidden md:block w-8 h-8 lg:w-12 lg:h-12 fill-current text-black"
                  >
                    <path
                      d="M14 2H5.50003L4.00003 3.5L6.83581 6.33579L0.585815 12.5858L3.41424 15.4142L9.66424 9.16421L12.5 12L14 10.5L14 2Z"
                      fill="currentColor"></path>
                  </svg>
                </div>

                <p
                  class="font-body text-lg md:text-xl font-medium mb-6 relative z-10"
                >
                  {t.dimensios_desc[lang]}
                </p>

                <div class="z-10 relative mt-auto">
                  <span
                    class="bg-black text-white px-3 py-1 text-xs sm:text-sm font-bold uppercase mb-2 inline-block"
                    >Three.js + React</span
                  >
                  <p class="font-body text-xl md:text-2xl font-bold">
                    {t.interactive_experience[lang]}
                  </p>
                </div>
              </div>
            </div>
          </a>

          <!-- Card 2 (Smog) -->
          <a
            href="https://youtu.be/BPYK-eoCLBw"
            target="_blank"
            rel="noopener noreferrer"
            class="block group relative cursor-crosshair sound-hover lg:row-span-2"
          >
            <div
              class="absolute inset-0 bg-neo-pink border-4 border-black translate-x-4 translate-y-4 transition-transform group-hover:translate-x-8 group-hover:translate-y-8"
            >
            </div>
            <div
              class="relative bg-white border-4 border-black p-6 sm:p-8 flex flex-col md:flex-row lg:flex-col xl:flex-row gap-8 transition-transform group-hover:-translate-x-2 group-hover:-translate-y-2 overflow-hidden h-full min-h-[400px]"
            >
              <div
                class="absolute -left-16 -bottom-16 w-56 h-56 bg-neo-orange rounded-none rotate-45 opacity-60 blur-xl group-hover:blur-3xl transition-all duration-500 group-hover:scale-150"
              >
              </div>

              <!-- Mockup Image Slot -->
              <div
                class="w-full md:w-1/2 lg:w-full xl:w-1/2 aspect-[2/3] md:aspect-auto min-h-[250px] border-4 border-black bg-white flex items-center justify-center relative z-10 overflow-hidden group"
              >
                <Image
                  src={smogImg}
                  alt={t.alt_smog[lang]}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </div>

              <div
                class="w-full md:w-1/2 lg:w-full xl:w-1/2 flex flex-col justify-center"
              >
                <div
                  class="flex justify-between items-start z-10 relative mb-4"
                >
                  <h3
                    class="text-3xl sm:text-4xl font-black leading-tight"
                    set:html={t.smog_title[lang]}
                  />
                  <svg
                    viewBox="0 0 16 16"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    class="hidden md:block w-8 h-8 lg:w-10 lg:h-10 xl:w-12 xl:h-12 fill-current text-black shrink-0"
                  >
                    <path
                      d="M14 2H5.50003L4.00003 3.5L6.83581 6.33579L0.585815 12.5858L3.41424 15.4142L9.66424 9.16421L12.5 12L14 10.5L14 2Z"
                      fill="currentColor"></path>
                  </svg>
                </div>
                <p
                  class="font-body text-base md:text-lg font-medium mb-6 relative z-10"
                >
                  {t.smog_desc[lang]}
                </p>
                <div class="z-10 relative mt-auto">
                  <span
                    class="bg-black text-white px-3 py-1 text-xs sm:text-sm font-bold uppercase mb-2 inline-block"
                    >{t.platformer[lang]}</span
                  >
                  <p class="font-body text-xl md:text-2xl font-bold">
                    {t.watch_gameplay[lang]}
                  </p>
                </div>
              </div>
            </div>
          </a>

          <!-- Card 3 (A Medias) -->
          <a
            href="https://www.youtube.com/watch?v=gH6VYi887M4"
            target="_blank"
            rel="noopener noreferrer"
            class="block group relative cursor-crosshair sound-hover lg:row-span-2"
          >
            <div
              class="absolute inset-0 bg-neo-green border-4 border-black translate-x-4 translate-y-4 transition-transform group-hover:translate-x-8 group-hover:translate-y-8"
            >
            </div>
            <div
              class="relative bg-white border-4 border-black p-6 sm:p-8 flex flex-col md:flex-row lg:flex-col xl:flex-row gap-8 transition-transform group-hover:-translate-x-2 group-hover:-translate-y-2 overflow-hidden h-full min-h-[400px]"
            >
              <!-- Mockup Image Slot -->
              <div
                class="w-full md:w-1/2 lg:w-full xl:w-1/2 aspect-[3/4] md:aspect-auto min-h-[250px] border-4 border-black bg-gray-200 flex items-center justify-center relative z-10 overflow-hidden group"
              >
                <Image
                  src={aMediasImg}
                  alt={t.alt_amedias[lang]}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </div>

              <div
                class="w-full md:w-1/2 lg:w-full xl:w-1/2 flex flex-col justify-center"
              >
                <div
                  class="flex justify-between items-start z-10 relative mb-4"
                >
                  <h3 class="text-3xl sm:text-4xl font-black leading-tight">
                    A MEDIAS
                  </h3>
                  <svg
                    viewBox="0 0 16 16"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    class="hidden md:block w-8 h-8 lg:w-10 lg:h-10 xl:w-12 xl:h-12 fill-current text-black shrink-0"
                  >
                    <path
                      d="M14 2H5.50003L4.00003 3.5L6.83581 6.33579L0.585815 12.5858L3.41424 15.4142L9.66424 9.16421L12.5 12L14 10.5L14 2Z"
                      fill="currentColor"></path>
                  </svg>
                </div>
                <p
                  class="font-body text-base md:text-lg font-medium mb-6 relative z-10"
                >
                  {t.amedias_desc[lang]}
                </p>
                <div class="z-10 relative mt-auto">
                  <span
                    class="bg-black text-white px-3 py-1 text-xs sm:text-sm font-bold uppercase mb-2 inline-block"
                    >{t.vr_interactive[lang]}</span
                  >
                  <p class="font-body text-xl md:text-2xl font-bold">
                    {t.vr_animation[lang]}
                  </p>
                </div>
              </div>
            </div>
          </a>

          <!-- Card 4 (Animaciones) -->
          <div
            class="group relative cursor-crosshair sound-hover lg:col-span-2"
          >
            <div
              class="absolute inset-0 bg-black border-4 border-black translate-x-4 translate-y-4 transition-transform group-hover:translate-x-8 group-hover:translate-y-8"
            >
            </div>
            <div
              class="relative bg-white border-4 border-black p-6 sm:p-8 flex flex-col md:flex-row gap-8 transition-transform group-hover:-translate-x-2 group-hover:-translate-y-2 overflow-hidden min-h-[300px]"
            >
              <!-- Mockup Image Slot -->
              <div
                class="w-full md:w-1/2 aspect-square min-h-[250px] border-4 border-black bg-black flex items-center justify-center relative z-10 overflow-hidden group"
              >
                <video
                  src={demoReel}
                  autoplay
                  loop
                  muted
                  playsinline
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                ></video>
              </div>

              <div class="w-full md:w-1/2 flex flex-col justify-center">
                <h3
                  class="text-3xl sm:text-5xl font-black z-10 relative leading-tight mb-4 text-black"
                >
                  {t.animation_title[lang]}
                </h3>
                <div class="z-10 relative">
                  <span
                    class="bg-neo-green text-black border-2 border-black px-3 py-1 text-xs sm:text-sm font-bold uppercase mb-4 inline-block shadow-[2px_2px_0px_rgba(0,0,0,1)]"
                    >{t.animation_tags[lang]}</span
                  >

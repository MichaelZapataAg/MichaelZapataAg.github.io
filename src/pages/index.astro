---
import { Image } from "astro:assets";
import "../styles/global.css";

import maikImg from "../assets/images/Maik.jpeg";
import dimensioImg from "../assets/images/MockupDimensio.png";
import smogImg from "../assets/images/PosterSmog.png";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/mz-icon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MICHAEL ZAPATA | CREATIVE DEVELOPER & 3D ARTIST</title>
  </head>
  <body class="bg-paper text-black">
    <!-- 3D Canvas Background Removed, see Hero -->

    <div class="noise-overlay"></div>

    <div
      class="relative z-10 wrapper w-full min-h-screen overflow-hidden flex flex-col gap-32"
    >
      <!-- Hero Header -->
      <header
        class="min-h-screen w-full flex flex-col justify-center items-start px-6 sm:px-12 md:px-20 lg:px-32 pt-24"
      >
        <div
          class="brutal-box bg-neo-green px-4 py-2 mt-0 mb-1 sm:mb-2 inline-block transform -rotate-2 brutal-shadow init-animate"
        >
          <span
            class="font-display font-black text-xl md:text-2xl uppercase tracking-tighter"
            >HOLA, SOY</span
          >
        </div>

        <div class="flex flex-col items-start gap-0 relative">
          <h1
            class="text-[14vw] sm:text-[16vw] leading-[0.85] font-black text-outline uppercase relative title-animate inline-block group cursor-crosshair interactive-name m-0 p-0"
          >
            <span class="block hover-glitch" data-text="Michael">Michael</span>
            <span
              class="text-black -webkit-text-stroke-0 block hover-glitch"
              data-text="Zapata">Zapata</span
            >
          </h1>

          <div
            class="relative z-10 group cursor-crosshair portfolio-badge init-animate inline-block self-end -mt-2 sm:-mt-4 md:-mt-6 mr-2 sm:mr-8 md:mr-12 opacity-0"
          >
            <span
              class="inline-block font-display font-black text-[10px] sm:text-xs md:text-sm tracking-[0.2em] md:tracking-[0.3em] uppercase border-4 border-black px-3 py-1 md:px-4 md:py-2 bg-paper hover:bg-black hover:text-white transition-colors duration-300"
            >
              [ PORTAFOLIO ]
            </span>
          </div>
        </div>

        <div
          class="mt-8 md:mt-12 relative w-full flex flex-col lg:flex-row justify-between items-center gap-8 lg:gap-12 desc-box"
        >
          <!-- 3D Canvas Box -->
          <div
            id="canvas-container"
            class="w-full lg:w-1/2 xl:w-7/12 h-[350px] sm:h-[450px] lg:h-[500px] cursor-crosshair init-animate flex justify-center items-center"
          >
            <canvas id="webgl" class="w-full h-full outline-none block"
            ></canvas>
          </div>
          <!-- Pink Text Box -->
          <div
            class="brutal-box bg-neo-pink text-white w-full sm:w-3/4 lg:w-1/2 xl:w-5/12 p-6 md:p-10 brutal-shadow rotate-1 transform-gpu init-animate delay-200 z-10 relative"
          >
            <!-- Photo Placeholder -->
            <div
              class="absolute -top-12 -right-4 sm:-top-16 sm:-right-8 w-24 h-24 sm:w-32 sm:h-32 border-4 border-black bg-white brutal-shadow rotate-6 overflow-hidden flex items-center justify-center z-20"
            >
              <Image
                src={maikImg}
                alt="Michael"
                class="w-full h-full object-cover absolute inset-0"
              />
            </div>

            <p
              class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-display font-black leading-tight uppercase relative z-10 pr-12 break-words hyphens-auto"
            >
              Ingeniero en Diseño de Entretenimiento Digital
            </p>
            <p
              class="mt-6 text-lg sm:text-xl md:text-2xl font-body font-medium leading-relaxed"
            >
              No te aburro con líneas genéricas, dejo que mis visuales hablen
              por mí. Código crudo, experiencias memorables y píxeles en tres
              dimensiones disparados al navegador.
            </p>
            <a
              href="#contacto"
              class="inline-block bg-black text-white w-max mt-8 px-8 py-4 font-display font-black text-lg md:text-xl border-4 border-black hover:bg-neo-blue hover:text-white hover:border-black transition-colors sound-hover"
              >ESTABLECER CONTACTO →</a
            >
          </div>
        </div>
      </header>

      <!-- Marquee divider -->
      <div
        class="marquee-container -rotate-2 z-20 brutal-shadow relative w-full overflow-hidden"
      >
        <div class="marquee-content text-black">
          DESARROLLO CREATIVO &nbsp; • &nbsp; ANIMACIÓN 3D &nbsp; • &nbsp;
          INTERFACES BRUTALISTAS &nbsp; • &nbsp; DESARROLLO CREATIVO &nbsp; •
          &nbsp; ANIMACIÓN 3D &nbsp; • &nbsp; INTERFACES BRUTALISTAS &nbsp; •
          &nbsp;
        </div>
      </div>

      <!-- Arsenal Section -->
      <section
        class="py-16 md:py-24 grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-12 items-start border-t-8 border-black pt-20 px-6 sm:px-12 md:px-20 lg:px-32"
      >
        <div class="w-full relative z-10 overflow-hidden lg:overflow-visible">
          <h2
            class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-black mb-8 leading-none"
          >
            MI <br /> ARSENAL
          </h2>
          <div class="flex flex-wrap gap-2 sm:gap-3 mb-16">
            {
              [
                { n: "Three.JS", c: "hover:bg-neo-blue" },
                { n: "HTML", c: "hover:bg-neo-orange" },
                { n: "CSS", c: "hover:bg-neo-blue" },
                { n: "JS", c: "hover:bg-neo-green hover:text-black" },
                { n: "Blender", c: "hover:bg-neo-orange" },
                { n: "Maya", c: "hover:bg-neo-blue" },
                { n: "Adobe Suite", c: "hover:bg-neo-pink" },
                { n: "Office Suite", c: "hover:bg-neo-orange" },
                { n: "Aseprite", c: "hover:bg-neo-blue" },
                { n: "Unity", c: "hover:bg-black" },
                { n: "Git/Github", c: "hover:bg-gray-800" },
                { n: "IAs generativas", c: "hover:bg-neo-pink" },
              ].map((skill) => (
                <span
                  class={`px-3 py-2 sm:px-5 sm:py-3 border-4 border-black bg-white font-display font-black text-xs sm:text-sm md:text-base uppercase brutal-shadow ${skill.c} hover:text-white transition-colors cursor-crosshair sound-hover`}
                >
                  {skill.n}
                </span>
              ))
            }
          </div>

          <h3 class="text-3xl sm:text-4xl font-black mb-6 uppercase">
            Habilidades Blandas
          </h3>
          <div class="flex flex-wrap gap-2 sm:gap-3">
            {
              [
                "Resolución de problemas",
                "Creatividad",
                "Trabajo en equipo",
                "Adaptabilidad",
                "Comunicación asertiva",
                "Pensamiento lateral",
              ].map((skill) => (
                <span class="px-3 py-2 sm:px-4 sm:py-2 border-4 border-black bg-neo-green font-display font-black text-xs sm:text-sm uppercase brutal-shadow hover:bg-black hover:text-white transition-colors cursor-crosshair sound-hover">
                  {skill}
                </span>
              ))
            }
          </div>
        </div>

        <div
          class="flex flex-col items-center justify-start lg:justify-end gap-12 mt-4 lg:mt-0 w-full"
        >
          <div
            class="bg-neo-orange p-6 sm:p-8 md:p-12 border-4 border-black brutal-shadow w-full max-w-xl rotate-1 transform-gpu z-0"
          >
            <h3 class="text-4xl md:text-5xl font-black mb-6">¿POR QUÉ YO?</h3>
            <p
              class="text-xl md:text-2xl font-body font-medium leading-relaxed"
            >
              Me especializo en crear productos visualmente magnéticos y
              funcionalmente impecables. Mi estilo es versátil: puedo abrazar
              desde el minimalismo más pulido hasta interfaces brutalistas o
              inmersivas que desafían las convenciones.
            </p>
          </div>
        </div>
      </section>

      <!-- Playground Section -->
      <section
        class="py-20 md:py-32 px-6 sm:px-12 md:px-20 lg:px-32 border-t-8 border-black"
      >
        <h2
          class="text-[12vw] sm:text-[10vw] md:text-8xl font-black mb-20 text-center text-outline leading-tight"
        >
          PROYECTOS
        </h2>
        <div
          class="grid grid-cols-1 lg:grid-cols-2 gap-16 md:gap-12 w-full mx-auto"
        >
          <!-- Card 1 (Dimensios) -->
          <a
            href="https://michaelzapataag-dimensios.vercel.app/"
            target="_blank"
            rel="noopener noreferrer"
            class="block group relative cursor-crosshair"
          >
            <div
              class="absolute inset-0 bg-neo-blue border-4 border-black translate-x-4 translate-y-4 transition-transform group-hover:translate-x-8 group-hover:translate-y-8"
            >
            </div>
            <div
              class="relative bg-white border-4 border-black p-6 sm:p-8 flex flex-col transition-transform group-hover:-translate-x-2 group-hover:-translate-y-2 overflow-hidden min-h-[400px]"
            >
              <div
                class="absolute -right-16 -top-16 w-56 h-56 bg-neo-green rounded-full opacity-60 blur-xl group-hover:blur-3xl transition-all duration-500 group-hover:scale-150"
              >
              </div>

              <!-- Mockup Image Slot -->
              <div
                class="w-full h-40 sm:h-48 border-4 border-black bg-white mb-6 flex items-center justify-center relative z-10 overflow-hidden group"
              >
                <Image
                  src={dimensioImg}
                  alt="Dimensios"
                  class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500"
                />
              </div>

              <div class="flex justify-between items-start z-10 relative mb-4">
                <h3 class="text-3xl sm:text-4xl font-black">DIMENSIOS</h3>
                <span class="text-4xl">↗</span>
              </div>
              <div class="z-10 relative mt-auto">
                <span
                  class="bg-black text-white px-3 py-1 text-xs sm:text-sm font-bold uppercase mb-2 inline-block"
                  >Three.js + React</span
                >
                <p class="font-body text-xl md:text-2xl font-bold">
                  Experiencia 3D Interactiva
                </p>
              </div>
            </div>
          </a>

          <!-- Card 2 (Smog) -->
          <div
            class="group relative cursor-crosshair sound-hover lg:row-span-2"
          >
            <div
              class="absolute inset-0 bg-neo-pink border-4 border-black translate-x-4 translate-y-4 transition-transform group-hover:translate-x-8 group-hover:translate-y-8"
            >
            </div>
            <div
              class="relative bg-white border-4 border-black p-6 sm:p-8 flex flex-col md:flex-row lg:flex-col xl:flex-row gap-8 transition-transform group-hover:-translate-x-2 group-hover:-translate-y-2 overflow-hidden h-full min-h-[400px]"
            >
              <div
                class="absolute -left-16 -bottom-16 w-56 h-56 bg-neo-orange rounded-none rotate-45 opacity-60 blur-xl group-hover:blur-3xl transition-all duration-500 group-hover:scale-150"
              >
              </div>

              <!-- Mockup Image Slot -->
              <div
                class="w-full md:w-1/2 lg:w-full xl:w-1/2 h-64 sm:h-80 md:h-auto border-4 border-black bg-white flex items-center justify-center relative z-10 overflow-hidden group"
              >
                <Image
                  src={smogImg}
                  alt="Smog"
                  class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500"
                />
              </div>

              <div
                class="w-full md:w-1/2 lg:w-full xl:w-1/2 flex flex-col justify-center"
              >
                <h3
                  class="text-3xl sm:text-4xl font-black z-10 relative leading-tight mb-4"
                >
                  LA VENGANZA <br />DEL SMOG
                </h3>
                <div class="z-10 relative mt-auto">
                  <span
                    class="bg-black text-white px-3 py-1 text-xs sm:text-sm font-bold uppercase mb-2 inline-block"
                    >Plataformero 2D / Pixel Art</span
                  >
                  <p class="font-body text-xl md:text-2xl font-bold">
                    Próximamente...
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 3 (A Medias) -->
          <a
            href="https://www.youtube.com/watch?v=gH6VYi887M4"
            target="_blank"
            rel="noopener noreferrer"
            class="block group relative cursor-crosshair sound-hover lg:row-span-2"
          >
            <div
              class="absolute inset-0 bg-neo-green border-4 border-black translate-x-4 translate-y-4 transition-transform group-hover:translate-x-8 group-hover:translate-y-8"
            >
            </div>
            <div
              class="relative bg-white border-4 border-black p-6 sm:p-8 flex flex-col md:flex-row lg:flex-col xl:flex-row gap-8 transition-transform group-hover:-translate-x-2 group-hover:-translate-y-2 overflow-hidden h-full min-h-[400px]"
            >
              <!-- Mockup Image Slot -->
              <div
                class="w-full md:w-1/2 lg:w-full xl:w-1/2 h-64 sm:h-80 md:h-auto border-4 border-black bg-gray-200 flex items-center justify-center relative z-10 overflow-hidden"
              >
                <span
                  class="font-display font-black text-gray-400 text-sm tracking-widest text-center"
                  >[ VIDEO IMAGEN <br /> 16:9 ]</span
                >
              </div>

              <div
                class="w-full md:w-1/2 lg:w-full xl:w-1/2 flex flex-col justify-center"
              >
                <h3
                  class="text-3xl sm:text-4xl font-black z-10 relative leading-tight mb-4"
                >
                  A MEDIAS
                </h3>
                <div
                  class="z-10 relative mt-auto flex flex-col justify-between items-start"
                >
                  <div>
                    <span
                      class="bg-black text-white px-3 py-1 text-xs sm:text-sm font-bold uppercase mb-2 inline-block"
                      >VR / Interactivo</span
                    >
                    <p class="font-body text-xl md:text-2xl font-bold mb-4">
                      Animación interactiva en Realidad Virtual
                    </p>
                  </div>
                  <span class="text-4xl">↗</span>
                </div>
              </div>
            </div>
          </a>

          <!-- Card 4 (Modelado 3D) -->
          <div class="group relative cursor-crosshair sound-hover">
            <div
              class="absolute inset-0 bg-neo-orange border-4 border-black translate-x-4 translate-y-4 transition-transform group-hover:translate-x-8 group-hover:translate-y-8"
            >
            </div>
            <div
              class="relative bg-white border-4 border-black p-6 sm:p-8 flex flex-col transition-transform group-hover:-translate-x-2 group-hover:-translate-y-2 overflow-hidden min-h-[400px]"
            >
              <!-- Mockup Image Slot -->
              <div
                class="w-full h-40 sm:h-48 border-4 border-black bg-gray-200 mb-6 flex items-center justify-center relative z-10 overflow-hidden"
              >
                <span
                  class="font-display font-black text-gray-400 text-sm tracking-widest"
                  >[ MOCKUP IMAGEN ]</span
                >
              </div>

              <h3
                class="text-3xl sm:text-4xl font-black z-10 relative leading-tight mb-4"
              >
                MODELADO 3D
              </h3>
              <div class="z-10 relative mt-auto">
                <span
                  class="bg-black text-white px-3 py-1 text-xs sm:text-sm font-bold uppercase mb-2 inline-block"
                  >Blender / Maya</span
                >
                <p class="font-body text-xl md:text-2xl font-bold">
                  Personajes, Props & Escenarios
                </p>
              </div>
            </div>
          </div>

          <!-- Card 5 (Animaciones) -->
          <div
            class="group relative cursor-crosshair sound-hover lg:col-span-2"
          >
            <div
              class="absolute inset-0 bg-black border-4 border-black translate-x-4 translate-y-4 transition-transform group-hover:translate-x-8 group-hover:translate-y-8"
            >
            </div>
            <div
              class="relative bg-white border-4 border-black p-6 sm:p-8 flex flex-col md:flex-row gap-8 transition-transform group-hover:-translate-x-2 group-hover:-translate-y-2 overflow-hidden min-h-[300px]"
            >
              <!-- Mockup Image Slot -->
              <div
                class="w-full md:w-1/2 h-48 md:h-full border-4 border-black bg-gray-200 flex items-center justify-center relative z-10 overflow-hidden"
              >
                <span
                  class="font-display font-black text-gray-400 text-sm tracking-widest"
                  >[ SHOWREEL ]</span
                >
              </div>

              <div class="w-full md:w-1/2 flex flex-col justify-center">
                <h3
                  class="text-3xl sm:text-5xl font-black z-10 relative leading-tight mb-4 text-black"
                >
                  ANIMACIÓN GENERAL
                </h3>
                <div class="z-10 relative">
                  <span
                    class="bg-neo-green text-black border-2 border-black px-3 py-1 text-xs sm:text-sm font-bold uppercase mb-4 inline-block shadow-[2px_2px_0px_rgba(0,0,0,1)]"
                    >Motion Graphics / 3D Animation</span
                  >
                  <p class="font-body text-xl md:text-2xl font-medium mt-2">
                    Una colección de mis mejores piezas animadas, abarcando
                    desde motion graphics limpios hasta simulaciones complejas.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Footer -->
      <footer
        id="contacto"
        class="pt-20 pb-10 border-t-8 border-black text-center relative z-20 bg-paper"
      >
        <div class="w-full flex justify-center mb-16">
          <h2
            class="text-[9vw] font-black hover:text-neo-blue transition-colors cursor-pointer text-outline hover:text-solid leading-[0.8] sound-hover group"
          >
            <a
              href="mailto:michael.zapata.ag@gmail.com"
              class="flex items-center justify-center gap-4 md:gap-8"
            >
              <span class="text-[5vw] text-solid group-hover:animate-bounce"
                >✉️</span
              >
              HABLEMOS
              <span
                class="text-[5vw] text-solid transition-transform group-hover:translate-x-4 group-hover:-translate-y-4"
                >↗</span
              >
            </a>
          </h2>
        </div>

        <div class="flex flex-wrap justify-center gap-6 md:gap-12 mb-20 px-4">
          <a
            href="mailto:michael.zapata.ag@gmail.com"
            class="font-display font-black text-xl md:text-2xl uppercase border-b-8 border-transparent hover:border-black transition-all"
            >Email</a
          >
          <a
            href="https://wa.me/573022577219"
            target="_blank"
            rel="noreferrer"
            class="font-display font-black text-xl md:text-2xl uppercase border-b-8 border-transparent hover:border-black transition-all"
            >WhatsApp</a
          >
          <a
            href="https://www.linkedin.com/in/michaelzapataag/"
            target="_blank"
            rel="noreferrer"
            class="font-display font-black text-xl md:text-2xl uppercase border-b-8 border-transparent hover:border-black transition-all"
            >LinkedIn</a
          >
          <a
            href="https://github.com/MichaelZapataAg"
            target="_blank"
            rel="noreferrer"
            class="font-display font-black text-xl md:text-2xl uppercase border-b-8 border-transparent hover:border-black transition-all"
            >GitHub</a
          >
          <a
            href="https://sketchfab.com/MichaelZapataAg"
            target="_blank"
            rel="noreferrer"
            class="font-display font-black text-xl md:text-2xl uppercase border-b-8 border-transparent hover:border-black transition-all"
            >Sketchfab</a
          >
        </div>

        <p class="font-body font-bold text-xl uppercase tracking-wider">
          © {new Date().getFullYear()} Michael Zapata - HECHO CON <span
            class="bg-neo-green px-2 text-black border-2 border-black inline-block -rotate-3"
            >ACTITUD</span
          >
        </p>
      </footer>
    </div>

    <script>
      import * as THREE from "three";
      import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      /**============================================
       * AUDIO FEEDBACK
       *=============================================**/
      const AudioContext =
        window.AudioContext || (window as any).webkitAudioContext;
      let audioCtx: AudioContext | null = null;

      const playBoop = () => {
        if (!audioCtx) audioCtx = new AudioContext(); // Init on first interaction
        if (audioCtx.state === "suspended") audioCtx.resume();
        const osc = audioCtx.createOscillator();
        const gainNode = audioCtx.createGain();
        osc.type = "square";
        osc.frequency.setValueAtTime(150, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(
          40,
          audioCtx.currentTime + 0.1,
        );
        gainNode.gain.setValueAtTime(0.015, audioCtx.currentTime);
        gainNode.gain.exponentialRampToValueAtTime(
          0.0001,
          audioCtx.currentTime + 0.1,
        );
        osc.connect(gainNode);
        gainNode.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.1);
      };

      document.querySelectorAll("a, .sound-hover").forEach((el) => {
        el.addEventListener("mouseenter", playBoop);
      });

      /**============================================
       * INTERACTIVE MAGNETIC PORTFOLIO TEXT
       *=============================================**/
      const badge = document.querySelector(".portfolio-badge");
      if (badge) {
        badge.addEventListener("mousemove", (e: any) => {
          const rect = badge.getBoundingClientRect();
          const x = e.clientX - rect.left - rect.width / 2;
          const y = e.clientY - rect.top - rect.height / 2;
          gsap.to(badge, {
            x: x * 0.4,
            y: y * 0.4,
            duration: 0.3,
            ease: "power2.out",
          });
        });
        badge.addEventListener("mouseleave", () => {
          gsap.to(badge, {
            x: 0,
            y: 0,
            duration: 0.5,
            ease: "elastic.out(1, 0.3)",
          });
        });
      }

      /**============================================
       * INTERACTIVE GLITCH NAME HOVER
       *=============================================**/
      const nameHoverElements = document.querySelectorAll(
        ".interactive-name .hover-glitch",
      );
      nameHoverElements.forEach((el) => {
        el.addEventListener("mouseenter", () => {
          gsap.to(el, {
            x: () => (Math.random() - 0.5) * 20,
            y: () => (Math.random() - 0.5) * 20,
            skewX: () => (Math.random() - 0.5) * 10,
            duration: 0.1,
            repeat: 3,
            yoyo: true,
            onComplete: () => {
              gsap.to(el, { x: 0, y: 0, skewX: 0, duration: 0.2 });
            },
          });

          if (audioCtx && audioCtx.state === "running") {
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = "sawtooth";
            osc.frequency.setValueAtTime(50, audioCtx.currentTime);
            osc.frequency.exponentialRampToValueAtTime(
              800,
              audioCtx.currentTime + 0.1,
            );
            gain.gain.setValueAtTime(0.005, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(
              0.0001,
              audioCtx.currentTime + 0.1,
            );
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start();
            osc.stop(audioCtx.currentTime + 0.1);
          }
        });
      });

      /**============================================
       * 3D SCENE SETUP
       *=============================================**/
      const canvasContainer = document.querySelector("#canvas-container");
      const canvas = document.querySelector("canvas#webgl");
      const scene = new THREE.Scene();

      const camera = new THREE.PerspectiveCamera(
        75,
        (canvasContainer?.clientWidth || window.innerWidth) /
          (canvasContainer?.clientHeight || window.innerHeight),
        0.1,
        100,
      );
      camera.position.z = 6;
      scene.add(camera);

      // Wireframe looks highly brutalist/technical
      const material = new THREE.MeshBasicMaterial({
        color: 0x000000,
        wireframe: true,
        wireframeLinewidth: 2,
        transparent: true,
        opacity: 0.15,
      });

      // An optional second mesh for double depth
      const materialSolid = new THREE.MeshStandardMaterial({
        color: 0xccff00, // neo-green
        roughness: 0.2,
        metalness: 0.8,
      });

      // Add lighting for the solid mesh
      const ambientLight = new THREE.AmbientLight(0xffffff, 0.5);
      scene.add(ambientLight);
      const dirLight = new THREE.DirectionalLight(0xff0055, 2); // pink light
      dirLight.position.set(5, 5, 5);
      scene.add(dirLight);
      const blueLight = new THREE.DirectionalLight(0x0033ff, 2);
      blueLight.position.set(-5, -5, 2);
      scene.add(blueLight);

      const group = new THREE.Group();
      scene.add(group);

      const loader = new GLTFLoader();
      loader.load(
        "/Personaje.glb",
        (gltf: any) => {
          const model = gltf.scene;

          // Auto-scale to fit roughly within 3.5 unit bounds cleanly
          const box = new THREE.Box3();
          box.setFromObject(model);

          // If box gets infinite bounds from Blender cameras/lights, recalculate via meshes
          const sizeCheck = box.getSize(new THREE.Vector3());
          if (sizeCheck.length() === 0 || sizeCheck.length() > 1000) {
            box.makeEmpty();
            model.traverse((child: any) => {
              if (child.isMesh) {
                child.geometry.computeBoundingBox();
                const childBox = child.geometry.boundingBox.clone();
                child.updateMatrixWorld(true);
                childBox.applyMatrix4(child.matrixWorld);
                box.union(childBox);
              }
            });
          }

          const center = box.getCenter(new THREE.Vector3());
          const size = box.getSize(new THREE.Vector3());
          const maxDim = Math.max(size.x, size.y, size.z) || 1;

          const scale = 3.5 / maxDim; // Make it a bit bigger in frame
          model.scale.setScalar(scale);

          // Center the model in the group and move it slightly down
          model.position.sub(center.clone().multiplyScalar(scale));
          model.position.y -= 0.5;

          // Override materials with the neo-green metal solid and wireframe loop
          model.traverse((child: any) => {
            if (child.isMesh) {
              child.material = materialSolid;

              // Add a slight wireframe clone for the brutalist UI style
              if (child.isSkinnedMesh) {
                const wireframe = new THREE.SkinnedMesh(
                  child.geometry,
                  material,
                );
                wireframe.bind(child.skeleton, child.bindMatrix);
                wireframe.scale.setScalar(1.02);
                child.add(wireframe);
              } else {
                const wireframe = new THREE.Mesh(child.geometry, material);
                wireframe.scale.setScalar(1.02);
                child.add(wireframe);
              }
            }
          });

          group.add(model);
        },
        undefined,
        (error: any) => {
          console.error("Error loading 3D model from /Personaje.glb:", error);
        },
      );

      const renderer = new THREE.WebGLRenderer({
        canvas: canvas,
        alpha: true,
        antialias: true,
      });

      const updateSize = () => {
        if (!canvasContainer) return;
        const width = canvasContainer.clientWidth;
        const height = canvasContainer.clientHeight;
        renderer.setSize(width, height);
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
      };

      updateSize();
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      window.addEventListener("resize", updateSize);

      const timer = new THREE.Timer();

      const tick = () => {
        timer.update();
        const elapsedTime = timer.getElapsed();

        // Idle rotation
        group.rotation.y = elapsedTime * 0.15;
        group.rotation.x = elapsedTime * 0.1;

        // Floating effect
        group.position.y += Math.sin(elapsedTime) * 0.002;

        renderer.render(scene, camera);
        window.requestAnimationFrame(tick);
      };
      tick();

      // Mouse interactive rotation with GSAP matching
      let mouse = { x: 0, y: 0 };
      window.addEventListener("mousemove", (event) => {
        if (!canvasContainer) return;

        // Only react fully if window is close to the container, or we just map it globally still but gentler
        mouse.x = event.clientX / window.innerWidth - 0.5;
        mouse.y = event.clientY / window.innerHeight - 0.5;

        gsap.to(group.rotation, {
          x: group.rotation.x + mouse.y * 1.5,
          y: group.rotation.y + mouse.x * 1.5,
          duration: 2,
          ease: "power2.out",
        });
      });

      /**============================================
       * GSAP UI ANIMATIONS
       *=============================================**/
      // Initial Load Animation
      const tl = gsap.timeline();

      tl.from(".title-animate", {
        y: 50,
        opacity: 0,
        duration: 1,
        ease: "power4.out",
        delay: 0.2,
      })
        .fromTo(
          ".init-animate",
          {
            scale: 0.8,
            rotation: -10,
            opacity: 0,
          },
          {
            scale: 1,
            rotation: 0, // Reset to inline block natural rotation or keep existing base. For the rotated box we might need from() without rotation if it breaks it, let's use a clear fromTo to keep opacity stable.
            opacity: 1,
            clearProps: "scale,rotation",
            duration: 0.8,
            stagger: 0.2,
            ease: "back.out(1.5)",
          },
          "-=0.5",
        )
        .from(
          group.scale,
          {
            x: 0,
            y: 0,
            z: 0,
            duration: 1.5,
            ease: "elastic.out(1, 0.75)",
          },
          "-=1",
        );

      // Animate 3D object dynamically based on scroll
      // Global spin and float
      ScrollTrigger.create({
        trigger: "body",
        start: "top top",
        end: "bottom bottom",
        onUpdate: (self) => {
          gsap.to(group.rotation, {
            y: "+=" + self.getVelocity() / 1000,
            z: "+=" + self.getVelocity() / 2000,
            duration: 0.5,
            ease: "power1.out",
          });
        },
      });
    </script>
  </body>
</html>
